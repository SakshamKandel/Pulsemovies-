# ==========================================
# Pulse Movies - Environment Variables
# ==========================================

# TMDB API Configuration (Required for movies/TV data)
NEXT_PUBLIC_TMDB_API_KEY=eda3f911cf7b26e9d911b7609d276198
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Site Branding & Public URL
NEXT_PUBLIC_SITE_NAME=Pulse
NEXT_PUBLIC_SITE_URL=https://pulsemovies.pages.dev

# NextAuth Authentication (Generate a random 32+ char string)
NEXTAUTH_URL=https://pulsemovies.pages.dev
NEXTAUTH_SECRET=pulse_movies_production_auth_secret_key_32_chars!
AUTH_SECRET=pulse_movies_production_auth_secret_key_32_chars!

# PostgreSQL Database (Optional for browsing, required for user accounts/history)
# Use a free cloud Postgres like Neon.tech or Supabase
DATABASE_URL=postgresql://postgres:password@your-db-host.neon.tech/neondb?sslmode=require
